(text "For instructions that save ALU to register, set to 00 (ALU)" (rect 528 72 864 85)(font "DejaVu Sans Condensed" (font_size 8)))
(text "For load instructions that save data MEM to register, set to 10 " (rect 560 280 926 293)(font "DejaVu Sans Condensed" (font_size 8)))
(text "GND just means currently only depends on op_load" (rect 560 392 860 405)(font "DejaVu Sans Condensed" (font_size 8)))
(text "For jump instructions that save PC to register, set to 00 " (rect 560 488 889 501)(font "DejaVu Sans Condensed" (font_size 8)))
(text "For instructions that dont save anything to register, set to 10 (arbitary)" (rect 552 680 969 693)(font "DejaVu Sans Condensed" (font_size 8)))
